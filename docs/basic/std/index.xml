&lt;/h1&gt;
&lt;ul&gt;
&lt;li&gt;sync.Mutex&lt;/li&gt;
&lt;li&gt;sync.RWMutex&lt;/li&gt;
&lt;li&gt;sync.WaitGroup&lt;/li&gt;
